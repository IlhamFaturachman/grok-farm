# =============================================================================
# Grok-Register config.env — Liam Farm Integration
# =============================================================================
# Combines Grok-Register protocol signup + Castle field + VPNX proxy + our IMAP
# =============================================================================

# ── 0) Run params (use CLI: grok start -t 10 --thread 2) ─────────────────────

# ── 1) Email: our custom domain IMAP ─────────────────────────────────────────
# We use our own email domains + IMAP (same as farm.py)
EMAIL_MODE=custom
EMAIL_DOMAIN=aduhteh.my.id
EMAIL_API=http://127.0.0.1:8099

# Alternating domains (set per-run or modify email.go)
# Domains: aduhteh.my.id, clique.web.id, gwidojaya.my.id, gwidopw.biz.id,
#          liamllc.biz.id, liamnevalackin.my.id, llciano.biz.id, tehaduh.biz.id

# ── 2) Proxy: VPNX Japan HTTP ─────────────────────────────────────────────────
# Farming goes through VPNX Japan (proven stable)
REGISTER_PROXY=http://vpnx:liam2026@172.18.0.1:8082
HTTPS_PROXY=http://vpnx:liam2026@172.18.0.1:8082
HTTP_PROXY=http://vpnx:liam2026@172.18.0.1:8082
NO_PROXY=127.0.0.1,localhost,172.18.0.1

# ── 3) Cloudflare clearance ──────────────────────────────────────────────────
# We already have WARP container — use it instead of Docker clearance stack
CLEARANCE_ENABLED=0
CLEARANCE_MODE=never
CLEARANCE_AUTO_STOP=0

# TLS fingerprint
CF_IMPERSONATE=chrome_131
CF_IMPERSONATE_FALLBACK=chrome_124,chrome_120

# ── 4) Turnstile ──────────────────────────────────────────────────────────────
TURNSTILE_PROVIDER=browser
TURNSTILE_MODE=offscreen

# Castle: currently empty (will be populated by castle_mint.py)
# castleRequestToken=""

# ── 5) Protocol ──────────────────────────────────────────────────────────────
PROTOCOL_HTTP=1
HTTP_POOL_SIZE=4

# ── 6) OAuth pacing ──────────────────────────────────────────────────────────
OAUTH_MIN_INTERVAL_SEC=6
OAUTH_RETRY_SEC=60
PROBE_ENABLED=1
PROBE_WARMUP_SEC=5

# ── 7) CPA upload to grok2api ────────────────────────────────────────────────
CPA_UPLOAD_ENABLED=0
# CPA_MANAGEMENT_BASE=http://127.0.0.1:8000/api/admin/v1
# CPA_MANAGEMENT_KEY=
