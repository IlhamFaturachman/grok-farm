[Unit]
Description=Grok Farm web control panel
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/grok-farm
Environment=FARM_DIR=/opt/grok-farm
Environment=FARM_PANEL_HOST=0.0.0.0
Environment=FARM_PANEL_PORT=9000
ExecStart=/opt/grok-farm/.venv/bin/python /opt/grok-farm/farm_panel.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
