[Unit]
Description=Grok2API traffic intel proxy + spy dashboard
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/grok-farm
Environment=FARM_DIR=/opt/grok-farm
Environment=TRAFFIC_HOST=0.0.0.0
Environment=TRAFFIC_PORT=8001
Environment=TRAFFIC_UPSTREAM=http://127.0.0.1:8000
Environment=TRAFFIC_DB=/opt/grok-farm/results/traffic.db
Environment=TRAFFIC_MAX_BODY_MB=128
ExecStart=/opt/grok-farm/.venv/bin/python /opt/grok-farm/traffic_intel.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
