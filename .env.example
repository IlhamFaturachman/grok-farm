# ── Grok Standalone Farmer ──────────────────────────────────────────────────
# Copy to .env and edit:  cp .env.example .env

# IMAP inbox that receives OTP (Gmail App Password recommended)
GROK_IMAP_USER=you@gmail.com
GROK_IMAP_PASS=xxxx xxxx xxxx xxxx
GROK_IMAP_HOST=imap.gmail.com
GROK_IMAP_PORT=993

# Email mode: domain | plus_trick
# domain     = random@catch-all (needs working catch-all → IMAP)
# plus_trick = you+random@gmail.com (OTP lands in same Gmail)
GROK_EMAIL_MODE=domain

# Catch-all domain (domain mode) — without leading @
GROK_EMAIL_DOMAIN=example.com

# Gmail base for plus_trick (optional; defaults to GROK_IMAP_USER)
# GROK_GMAIL_BASE=you@gmail.com

# Account password for all farmed xAI accounts
GROK_PASSWORD=@YourAccountGrokPass

# How many accounts to create this run
GROK_MAX_ACCOUNTS=5
GROK_CONCURRENT=1

# false = headed browser (recommended — Turnstile much more reliable)
# true  = headless (needs DISPLAY-less server; Turnstile may fail more)
GROK_HEADLESS=false

# Optional delay (seconds) between account spawns
GROK_SPAWN_DELAY=2

# Terminal UI: hud (default on TTY) | log (classic line spam)
# GROK_UI=hud
# GROK_VERBOSE=true   # show detail lines even with HUD (also always in farm.log)

# Fail-fast timeouts (stuck/unclear states free the worker slot)
# GROK_OTP_TIMEOUT=120          # IMAP wait for code
# GROK_CONFIRM_TIMEOUT=45       # still on Verify page → fail
# GROK_COMPLETE_TIMEOUT=90      # Turnstile/complete form stuck → fail
# GROK_ACCOUNT_TIMEOUT=480      # whole account hard deadline (8 min)

# ── Proxies (recommended for concurrent >1 / Turnstile) ─────────────────────
# Preferred: list file (one proxy per line). See proxies.txt.example
# GROK_PROXY_FILE=./proxies.txt
# If GROK_PROXY_FILE unset and ./proxies.txt exists, it is loaded automatically.
# GROK_PROXY_SHUFFLE=false
# Optional extra inline pool (merged with file), optional #id per entry:
# GROK_PROXY_POOL=http://user:pass@host:port,socks5://user:pass@host:port#node2

# Optional vision CAPTCHA (interactive puzzles only; managed Turnstile uses click)
# GROK_CAPTCHA_PROXY_URL=https://api.openai.com/v1/chat/completions
# GROK_CAPTCHA_API_KEY=sk-...
# GROK_CAPTCHA_MODEL=gpt-4o

# Results: each run creates results/batch_<timestamp>/ automatically
# GROK_RESULTS_DIR=./results
# Global email index (dedup across all batches) — auto-maintained
# GROK_USED_EMAILS_FILE=./results/used_emails.txt
# Local-part length for domain mode (crypto secrets, default 16)
# GROK_EMAIL_LOCAL_LEN=16
# Optional fixed batch id: GROK_BATCH_ID=my_batch_01
# Legacy single-file mode (disables per-batch folders):
# GROK_RESULTS_JSON=./results/accounts.json
# GROK_RESULTS_TXT=./results/accounts.txt
# GROK_FAILED_JSON=./results/failed.json
# GROK_SCREENSHOT_DIR=./screenshots

# ── grok2api (chenyme/grok2api) ─────────────────────────────────────────────
# Farm produces Grok CLI OIDC tokens → grok2api "Build" (grok_build) pool.
# Stack: docker compose up -d   (see docker-compose.yml)
# Setup: ./scripts/setup-grok2api.sh
#
# GROK2API_URL=http://127.0.0.1:8000
# GROK2API_ADMIN_USER=admin
# GROK2API_ADMIN_PASS=your-bootstrap-admin-password
# Write results/batch_*/g2a_import.json after each run (default: on if URL set)
# GROK2API_EXPORT=true
# POST import to admin API after each successful batch
# GROK2API_AUTO_IMPORT=false
#
# Manual export / import anytime:
#   python g2a_export.py results/batch_xxx/ -o g2a_import.json
#   python g2a_export.py results/batch_xxx/ --import

# ── Farm web control panel (farm_panel.py) ──────────────────────────────────
# FARM_PANEL_HOST=0.0.0.0
# FARM_PANEL_PORT=9000
# FARM_PANEL_USER=admin
# FARM_PANEL_PASSWORD=change-me   # defaults to GROK2API_ADMIN_PASS if unset
# systemd: deploy/farm-panel.service

# ── Continuous import pooler (g2a_pool.py) ──────────────────────────────────
# Watches results/ for new farmed accounts and imports only unseen emails.
# G2A_POOL_INTERVAL=20
# G2A_POOL_STATE=./results/g2a_pool_state.json
# G2A_POOL_CHECK_LIVE=true   # also skip emails already in grok2api pool
# systemd: deploy/g2a-pool.service

# ── Traffic intel proxy (traffic_intel.py) ──────────────────────────────────
# Sits in front of grok2api and logs full request/response for analysis.
# Point API clients at :8001 (not :8000) to capture traffic.
# Bound to 0.0.0.0 but firewalled (iptables) — only Docker + localhost can reach it.
# Docker nginx (api-gate) proxies /v1/ through this to capture traffic.
# Use scripts/tunnel.sh or scripts/tunnel.ps1 to access the dashboard.
# TRAFFIC_HOST=0.0.0.0
# TRAFFIC_PORT=8001
# TRAFFIC_UPSTREAM=http://127.0.0.1:8000
# TRAFFIC_DB=./results/traffic.db
# TRAFFIC_PANEL_PASSWORD=   # defaults to FARM_PANEL_PASSWORD / GROK2API_ADMIN_PASS
# TRAFFIC_MAX_BODY_MB=128   # keep aligned with nginx/grok2api (agent payloads)
# GROK_API_KEY=sk-xxx       # grok2api API key for AI project summaries (optional)
# GROK_SUMMARY_MODEL=grok-4.5 # model to use for summarization
# Dashboard: http://localhost:8001/intel (via SSH tunnel)
# systemd: deploy/traffic-intel.service

# ── HTTP-only farm (farm_http.py) ────────────────────────────────────────────
# No browser needed — uses curl_cffi + external Turnstile solver.
# Run: ./run_http.sh -n 10 -c 3 -y
#
# Boterdrop-Solver URL (run separately: python api_server.py from the solver repo)
# SOLVER_URL=http://127.0.0.1:8888
#
# Optional fallback: CapSolver API key (if Boterdrop is unavailable)
# CAPSOLVER_API_KEY=
#
# Browser fingerprint for curl_cffi (chrome131 recommended)
# GROK_IMPERSONATE=chrome131
#
# Per-account timeout (seconds) — HTTP is faster, but Turnstile solve can take 30-60s
# GROK_ACCOUNT_TIMEOUT=600
